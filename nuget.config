<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <add key="repositorypath" value="packages" />
  </config>
  <packageSources>
    <clear />
    <add key="msft_consumption_public" value="https://pkgs.dev.azure.com/azure-public/vside/_packaging/msft_consumption_public/nuget/v3/index.json" />
    <add key="vssdk" value="https://pkgs.dev.azure.com/azure-public/vside/_packaging/vssdk/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="msft_consumption_public">
      <package pattern="*" />
    </packageSource>
    <packageSource key="vssdk">
      <!-- Visual Studio SDK 18 requires these packages from the SDK feed. -->
      <package pattern="Microsoft.VisualStudio.Composition" />
      <package pattern="Microsoft.VisualStudio.Composition.Analyzers" />
      <package pattern="Microsoft.VisualStudio.Utilities.Internal" />
      <package pattern="Microsoft.VisualStudio.Validation" />
    </packageSource>
  </packageSourceMapping>
  <disabledPackageSources>
    <!-- Defend against user or machine level disabling of sources that we list in this file. -->
    <clear />
  </disabledPackageSources>
</configuration>
